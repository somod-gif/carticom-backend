# ============================================================
# CARTICOM BACKEND — Environment Variables
# ============================================================
# Copy to `backend/.env` for local development (it is git-ignored), or set these
# as real environment variables on the host (Pxxl). OS environment variables
# always take precedence over the .env file.
#
# NEVER commit real secrets. This file is an example only.
# ------------------------------------------------------------

# ─── Database (REQUIRED) ─────────────────────────────────────
# Secret. PostgreSQL JDBC URL. Neon/Render require sslmode=require.
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/carticom
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=postgres

# ─── Server ──────────────────────────────────────────────────
# Optional. Port the API listens on. Hosts that inject PORT (Render/Pxxl) are
# honoured automatically via `server.port`.
# SERVER_PORT=8080

# ─── JWT (REQUIRED) ──────────────────────────────────────────
# Secret. Base64-encoded HMAC key, decodes to >= 32 bytes.
# Generate with: openssl rand -base64 48
# The application refuses to start without it (no insecure fallback).
JWT_SECRET=
# Optional. Access-token lifetime in ms. Default 86400000 (24h).
# JWT_EXPIRATION=86400000

# ─── Application URL (REQUIRED) ──────────────────────────────
# Public. Base URL of the frontend. Used for password-reset links, staff-invite
# links and payment callback URLs.
APP_BASE_URL=https://carticom.cv

# ─── CORS (optional) ─────────────────────────────────────────
# Comma-separated extra browser origins allowed to call the API. The code
# already allows https://carticom.cv, https://www.carticom.cv,
# https://carticom.vercel.app and http://localhost:3000. Add Vercel preview
# URLs here, e.g. https://carticom-git-feature-x.vercel.app
CORS_ALLOWED_ORIGINS=

# ─── Demo / seed data (optional) ─────────────────────────────
# When true the app seeds a demo merchant, store, products and orders at boot.
SEED_DEMO_DATA=false
# Required only when SEED_DEMO_DATA=true. When blank no admin account is created.
ADMIN_EMAIL=admin@carticom.cv
ADMIN_PASSWORD=

# ─── Image storage (optional) ────────────────────────────────
# Secret. Byteship CDN API key. When unset, uploads fall back to local disk and
# are served from GET /api/v1/images/file/{filename}.
BYTESHIP_API_KEY=
# Optional. Directory used for the local-disk upload fallback.
# LOCAL_UPLOAD_DIR=uploads

# ─── Email (optional) ────────────────────────────────────────
# Secret. SendByte (primary transactional provider).
SENDBYTE_API_KEY=
# Optional. SendByte API base URL. Default https://api.sendbyte.africa/v1
# SENDBYTE_API_URL=
# Optional. From header for outbound mail.
# SENDBYTE_FROM_EMAIL=Carticom <orders@carticom.cv>
# Secret. Resend API key (alternative provider).
RESEND_API_KEY=
# RESEND_FROM_EMAIL=hello@carticom.dev

# ─── AI (optional) ───────────────────────────────────────────
# Secret. Cencori gateway key. AI endpoints return a disabled status when unset.
CENCORI_API_KEY=
# CENCORI_MODEL=groq/compound-mini

# ─── Payments (optional) ─────────────────────────────────────
# Secrets. Without these, card checkout is unavailable; the per-store
# merchant-connect credentials below are preferred at runtime.
PAYSTACK_SECRET_KEY=
FLUTTERWAVE_SECRET_KEY=
# NOMBA_CLIENT_ID=
# NOMBA_CLIENT_SECRET=
# NOMBA_ACCOUNT_ID=
# NOMBA_BASE_URL=https://sandbox.nomba.com/v1
# NOMBA_WEBHOOK_SIGNATURE_KEY=
