# ============================================
# CARTICOM BACKEND — Environment Variables
# Copy to backend/.env (loaded automatically by DotenvEnvironmentPostProcessor)
# Full docs: docs/DEPLOYMENT.md
# ============================================

# --- Required ---
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/carticom
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=postgres
# Base64 HMAC key >= 32 bytes. The app refuses to start without it.
# Generate: openssl rand -base64 48
JWT_SECRET=
# Public frontend URL — used in invite/reset links and payment callbacks
APP_BASE_URL=https://carticom.cv

# --- Optional: core ---
# JWT_EXPIRATION=86400000
# CORS_ALLOWED_ORIGINS=
# SERVER_PORT=8080
# SEED_DEMO_DATA=false
# ADMIN_EMAIL=admin@carticom.cv
# ADMIN_PASSWORD=

# --- Optional: integrations ---
BYTESHIP_API_KEY=
LOCAL_UPLOAD_DIR=uploads
SENDBYTE_API_KEY=
SENDBYTE_API_URL=https://api.sendbyte.africa/v1
SENDBYTE_FROM_EMAIL=Carticom <orders@carticom.cv>
RESEND_API_KEY=
RESEND_FROM_EMAIL=hello@carticom.dev
CENCORI_API_KEY=
CENCORI_MODEL=groq/compound-mini
PAYSTACK_SECRET_KEY=
FLUTTERWAVE_SECRET_KEY=
NOMBA_CLIENT_ID=
NOMBA_CLIENT_SECRET=
NOMBA_ACCOUNT_ID=
NOMBA_BASE_URL=https://sandbox.nomba.com/v1
NOMBA_WEBHOOK_SIGNATURE_KEY=

# --- Optional: rate limiting (all optional — these are the defaults) ---
# Per tier: RATELIMIT_<TIER>_CAPACITY / _REFILL_TOKENS / _REFILL_MINUTES
# Tiers: AUTH, UPLOAD, AI, PUBLIC, WRITE, DEFAULT
RATELIMIT_ENABLED=true
# RATELIMIT_AUTH_CAPACITY=10
# RATELIMIT_UPLOAD_CAPACITY=30
# RATELIMIT_AI_CAPACITY=20
# RATELIMIT_PUBLIC_CAPACITY=300
# RATELIMIT_WRITE_CAPACITY=60
# RATELIMIT_DEFAULT_CAPACITY=600
